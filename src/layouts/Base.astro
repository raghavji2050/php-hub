---
import { SITE } from '../lib.js';
import Newsletter from '../components/Newsletter.astro';
import Analytics from '@vercel/analytics/astro';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-700.css';
const { title = 'PHP Hub', description = SITE.description, type = 'website', image = '/og.png', jsonld = null, noindex = false, cta = true, newsletter = true, canonical: canonicalOverride = '' } = Astro.props;
const path = Astro.url.pathname;
const canonical = canonicalOverride || new URL(path.replace(/\/$/, '') || '/', SITE.url).href;
const fullTitle = title === 'PHP Hub' ? SITE.homeTitle : `${title} | PHP Hub`;
const gsc = (import.meta.env.PUBLIC_GSC_VERIFICATION || SITE.gscVerification || '').trim();
const imageUrl = new URL(image, SITE.url).href;
const org = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Organization', '@id': SITE.url + '/#organization', name: SITE.name, alternateName: ['PHPHub', 'PHP Hub'], url: SITE.url, logo: new URL('/icon-512.png', SITE.url).href, sameAs: SITE.sameAs },
  { '@type': 'WebSite', '@id': SITE.url + '/#website', name: SITE.name, alternateName: ['PHPHub', 'PHP Hub'], url: SITE.url, publisher: { '@id': SITE.url + '/#organization' }, inLanguage: 'en' } ] };
const nav = [['/briefs','Briefs'],['/articles','Articles'],['/lessons','Lessons'],['/services','Services'],['/search','Search']];
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="color-scheme" content="light dark"/><meta name="description" content={description}/>
<title>{fullTitle}</title>{gsc && <meta name="google-site-verification" content={gsc}/>}
<link rel="canonical" href={canonical}/>{noindex && <meta name="robots" content="noindex"/>}
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/>
<meta name="theme-color" content="#047857"/>
<link rel="alternate" type="application/rss+xml" title="PHP Hub" href="/rss.xml"/>
<meta property="og:type" content={type}/><meta property="og:site_name" content="PHP Hub"/><meta property="og:title" content={fullTitle}/>
<meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={imageUrl}/>
<meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={imageUrl}/>
<script type="application/ld+json" set:html={JSON.stringify(org)}/>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)}/>}
<style is:global>
:root{--bg:#f8fafc;--surface:#fff;--text:#0f172a;--muted:#475569;--border:#e2e8f0;--brand:#047857;--brand-strong:#065f46;--brand-ink:#fff;--brand-soft:#ecfdf5;--code:#f1f5f9;--pre:#0f172a;--pre-text:#e2e8f0;--crit:#b91c1c;--crit-bg:#fee2e2;--warn:#9a3412;--warn-bg:#ffedd5;--radius:14px;--shadow:0 1px 2px rgba(15,23,42,.06),0 8px 24px -12px rgba(15,23,42,.18)}
@media (prefers-color-scheme:dark){:root{--bg:#0b1120;--surface:#111827;--text:#f1f5f9;--muted:#94a3b8;--border:#1f2a3c;--brand:#34d399;--brand-strong:#6ee7b7;--brand-ink:#052e22;--brand-soft:#062a22;--code:#1e293b;--pre:#020617;--pre-text:#e2e8f0;--crit:#fca5a5;--crit-bg:#450a0a;--warn:#fdba74;--warn-bg:#431407;--shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px -12px rgba(0,0,0,.6)}}

*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);font:17px/1.65 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
a{color:var(--brand)}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
.site-header{border-bottom:1px solid var(--border);background:var(--surface)}
.site-header .wrap{position:relative;display:flex;align-items:center;gap:8px 20px;min-height:64px;flex-wrap:wrap;padding-top:8px;padding-bottom:8px}
.logo{font-weight:800;font-size:20px;letter-spacing:-.02em;color:var(--text);text-decoration:none;margin-right:auto}
.logo span{color:var(--brand)}
.nav{display:flex;gap:4px 16px;flex-wrap:wrap;align-items:center}
.nav a{color:var(--muted);text-decoration:none;font-size:15px;padding:4px 0}
.nav a:hover,.nav a[aria-current]{color:var(--text)}
.btn{display:inline-block;padding:10px 18px;border-radius:8px;font-weight:600;text-decoration:none;border:1px solid var(--brand);font-size:15px}
.btn.primary{background:var(--brand);color:var(--brand-ink)}.btn.secondary{color:var(--brand)}
.nav .btn{padding:6px 14px;color:var(--brand-ink)}
main{padding:32px 0 16px;display:block}
h1{font-size:clamp(28px,5vw,40px);line-height:1.2;letter-spacing:-.02em;margin:.2em 0 .5em}
h2{font-size:24px;letter-spacing:-.01em}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));padding:0}
.card{display:flex;flex-direction:column;gap:8px;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px;text-decoration:none;color:var(--text);transition:border-color .15s}
.card:hover{border-color:var(--brand)}.card h3{margin:0;font-size:18px;line-height:1.35}.card p{margin:0;color:var(--muted);font-size:15px}
.card time{color:var(--muted);font-size:13px;margin-top:auto}
.badges{display:flex;gap:6px;flex-wrap:wrap}
.badge{font-size:12px;font-weight:700;padding:2px 8px;border-radius:999px;background:var(--code);color:var(--muted);text-transform:uppercase;letter-spacing:.03em}
.badge.sev-critical,.badge.sev-high{background:var(--crit-bg);color:var(--crit)}.badge.status{background:var(--warn-bg);color:var(--warn)}
.prose{max-width:70ch;margin:0 auto;font-size:18px;line-height:1.75}
.prose h1{font-size:clamp(26px,4.5vw,36px)}.prose h2{margin-top:2em}.prose h3{margin-top:1.6em}
.prose p,.prose ul,.prose ol{margin:1em 0}.prose li{margin:.35em 0}
.prose code{background:var(--code);padding:.1em .35em;border-radius:4px;font-size:.88em;word-break:break-word}
.prose pre{background:var(--code);padding:14px 16px;border-radius:8px;overflow-x:auto;font-size:14px;line-height:1.55}.prose pre code{background:none;padding:0}
.prose table{border-collapse:collapse;display:block;overflow-x:auto}.prose td,.prose th{border:1px solid var(--border);padding:6px 10px}
.prose a{word-break:break-word}.prose blockquote{border-left:3px solid var(--brand);margin:1em 0;padding-left:16px;color:var(--muted)}
.back{font-size:15px;text-decoration:none}
.cta{border:1px solid var(--border);background:var(--brand-soft);border-radius:12px;padding:24px;margin:48px 0 24px}
.cta h2{margin:0 0 6px;font-size:20px}.cta p{margin:0 0 16px;color:var(--muted)}
.actions{display:flex;gap:12px;flex-wrap:wrap}
.site-footer{border-top:1px solid var(--border);margin-top:48px;padding:32px 0;color:var(--muted);font-size:14px}
.site-footer .wrap{display:grid;gap:24px;grid-template-columns:2fr 1fr 1fr 1fr}
.site-footer .fh{margin:0 0 8px;color:var(--text);font-size:14px}.site-footer ul{list-style:none;margin:0;padding:0}.site-footer li{margin:4px 0}
.site-footer a{color:var(--muted);text-decoration:none}.site-footer a:hover{color:var(--text)}
.copy{grid-column:1/-1;border-top:1px solid var(--border);padding-top:16px}
input,textarea{font:inherit;color:var(--text);background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:8px 10px}
button{font:inherit;padding:10px 18px;border-radius:8px;border:0;background:var(--brand);color:var(--brand-ink);font-weight:600}button:disabled{opacity:.55}
a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid var(--brand);outline-offset:2px;border-radius:4px}
.skip{position:absolute;left:-9999px}.skip:focus{left:12px;top:12px;background:var(--surface);padding:8px 12px;z-index:10}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.astro-code span[style*="#6A737D" i]{color:#959DA5!important}
.hp{position:absolute;left:-9999px}
.notice{border:1px solid #d97706;background:#fffbeb;color:#713f12;padding:12px;border-radius:8px}
@media (prefers-color-scheme:dark){.notice{background:#422006;color:#fde68a}}
.newsletter{border:1px solid var(--border);background:var(--surface);border-radius:12px;padding:24px;margin:24px 0}
.newsletter h2{margin:0 0 6px;font-size:20px}.newsletter p{color:var(--muted);margin:0 0 12px}
.nl-form{display:flex;gap:8px;flex-wrap:wrap}.nl-form input{flex:1;min-width:220px}
.meta{color:var(--muted);font-size:13px;margin-top:auto}
.card-title{margin:0;font-size:18px;line-height:1.35}
.tags{display:flex;gap:6px;flex-wrap:wrap;list-style:none;padding:0;margin:12px 0}
.tag{font-size:13px;padding:2px 10px;border:1px solid var(--border);border-radius:999px;text-decoration:none;color:var(--muted)}
.tag:hover{color:var(--text);border-color:var(--brand)}
.page-prose{max-width:70ch}.page-prose h2{margin-top:1.8em}
@media (max-width:640px){body{font-size:16px}.prose{font-size:17px}.site-footer .wrap{grid-template-columns:1fr 1fr}.site-footer .about{grid-column:1/-1}.nav{width:100%}.grid{grid-template-columns:1fr}}

body{font:17px/1.7 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",sans-serif;-webkit-font-smoothing:antialiased}
h1,h2,h3{color:var(--text);text-wrap:balance}
.wrap{max-width:1120px}
.site-header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--surface) 88%,transparent);backdrop-filter:saturate(1.4) blur(10px);-webkit-backdrop-filter:saturate(1.4) blur(10px)}
.site-header .wrap{flex-wrap:nowrap;min-height:64px}
.logo{display:inline-flex;align-items:center}
.logo::before{content:"";width:22px;height:24px;background:var(--brand);clip-path:polygon(50% 0,100% 18%,100% 55%,50% 100%,0 55%,0 18%);margin-right:8px}
.nav{gap:4px}.nav a{padding:8px 12px;border-radius:8px;font-weight:500}
.nav a:hover,.nav a[aria-current]{background:var(--code);color:var(--text)}
.nav .btn{margin-left:6px;padding:8px 16px}
.btn{border-radius:10px;padding:11px 20px;transition:background .15s,transform .15s,border-color .15s}
.btn.primary:hover{background:var(--brand-strong);border-color:var(--brand-strong)}.btn.secondary:hover{background:var(--brand-soft)}
.btn:active{transform:translateY(1px)}
.menu{display:none;margin-left:auto}
.menu summary{list-style:none;cursor:pointer;padding:8px 12px;border:1px solid var(--border);border-radius:10px;font-weight:600;font-size:15px}
.menu summary::-webkit-details-marker{display:none}
.menu[open] summary{background:var(--code)}
.menu .menu-panel{position:absolute;left:0;right:0;top:100%;background:var(--surface);border-bottom:1px solid var(--border);box-shadow:var(--shadow);padding:8px 20px 16px;display:grid;gap:2px}
.menu .menu-panel a{padding:12px 8px;border-radius:8px;color:var(--text);text-decoration:none;font-weight:500}
.menu .menu-panel a:hover{background:var(--code)}.menu .menu-panel .btn{margin-top:8px;text-align:center;color:var(--brand-ink)}
.card,.post-card{border-radius:var(--radius);box-shadow:var(--shadow)}
.card{transition:border-color .15s,transform .15s}.card:hover{transform:translateY(-2px)}
.prose{max-width:72ch}
.prose h2{font-size:clamp(22px,3vw,28px);padding-top:.2em;scroll-margin-top:80px}.prose h3{scroll-margin-top:80px}
.prose code{background:var(--code);border:1px solid var(--border)}
.prose pre,.prose pre.astro-code{background:var(--pre)!important;color:var(--pre-text);border:1px solid var(--border);border-radius:12px;padding:18px 20px;font-size:14.5px;box-shadow:var(--shadow)}
.prose pre code{border:0}
.prose img{max-width:100%;height:auto;border-radius:12px}
.prose blockquote{background:var(--brand-soft);border-left:4px solid var(--brand);border-radius:0 10px 10px 0;padding:10px 18px}
.prose th{background:var(--code);text-align:left}
.cta{border-radius:var(--radius);background:linear-gradient(135deg,var(--brand-soft),var(--surface));border-color:color-mix(in srgb,var(--brand) 30%,var(--border))}
.site-footer{background:var(--surface);margin-top:64px;padding:48px 0 32px}
.site-footer .about p{max-width:32ch}
@media (max-width:760px){.site-header .nav{display:none}.menu{display:block}}
/* ---- Modern alt theme: dark-first, glass, bento, CSS-only motion ---- */
:root{color-scheme:dark light;--bg:#070b14;--surface:#0f1626;--text:#eef2f7;--muted:#9aa7bb;--border:#1d2840;--brand:#34d399;--brand-strong:#6ee7b7;--brand-ink:#04241a;--brand-soft:#0a2a22;--code:#162036;--pre:#03060d;--pre-text:#e2e8f0;--accent:#22d3ee;--glass:rgba(15,22,38,.62);--glass-border:rgba(148,163,184,.16);--radius:18px;--shadow:0 1px 0 rgba(255,255,255,.04) inset,0 12px 32px -16px rgba(0,0,0,.7)}
@media (prefers-color-scheme:light){:root{--bg:#f6f8fb;--surface:#fff;--text:#0b1220;--muted:#475569;--border:#e2e8f0;--brand:#047857;--brand-strong:#065f46;--brand-ink:#fff;--brand-soft:#ecfdf5;--code:#f1f5f9;--pre:#0f172a;--accent:#0e7490;--glass:rgba(255,255,255,.7);--glass-border:rgba(15,23,42,.08);--shadow:0 1px 2px rgba(15,23,42,.06),0 12px 28px -14px rgba(15,23,42,.2)}}
body{background:var(--bg)}
h1,h2,h3,.logo,.btn,.badge,.eyebrow{font-family:"Space Grotesk",ui-sans-serif,system-ui,sans-serif}
h1,h2{letter-spacing:-.03em}
.site-header{background:var(--glass);border-bottom:1px solid var(--glass-border)}
.btn{border-radius:12px}
.btn.primary{background:linear-gradient(135deg,var(--brand),var(--accent));border-color:transparent;color:var(--brand-ink)}
.btn.primary:hover{filter:brightness(1.08);background:linear-gradient(135deg,var(--brand),var(--accent))}
.btn.secondary{background:var(--glass);border-color:var(--glass-border);color:var(--text)}
.card,.post-card{background:var(--glass);border-color:var(--glass-border);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.card:hover,.post-card:hover{border-color:color-mix(in srgb,var(--brand) 55%,transparent)}
.cta{background:radial-gradient(120% 140% at 0% 0%,color-mix(in srgb,var(--brand) 22%,transparent),transparent 60%),radial-gradient(120% 140% at 100% 100%,color-mix(in srgb,var(--accent) 18%,transparent),transparent 60%),var(--surface);border-color:var(--glass-border)}
.site-footer{background:var(--surface);border-top-color:var(--glass-border)}
@keyframes pp-rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
main>section,main>.grid{animation:pp-rise .5s ease-out both}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style></head><body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header"><div class="wrap">
<a class="logo" href="/">PHP<span>Hub</span></a>
<nav class="nav" aria-label="Main">{nav.map(([h,l]) => <a href={h} aria-current={path.startsWith(h) ? 'page' : undefined}>{l}</a>)}<a class="btn primary" href="/contact">Contact</a></nav>
<details class="menu"><summary aria-label="Open menu">Menu</summary><nav class="menu-panel" aria-label="Mobile">{nav.map(([h,l]) => <a href={h} aria-current={path.startsWith(h) ? 'page' : undefined}>{l}</a>)}<a class="btn primary" href="/contact">Contact</a></nav></details>
</div></header>
<main class="wrap" id="main"><slot/>
{cta && <section class="cta"><h2>Worried your PHP or WordPress site is affected?</h2>
<p>Start with the free checker. If you'd like a hand with a security audit or cleanup, get in touch and we'll take a look.</p>
<div class="actions"><a class="btn primary" href="/contact">Request an audit</a><a class="btn secondary" href="https://php-security-checker.vercel.app">Free PHP Security Checker</a></div></section>}
{newsletter && <Newsletter/>}
</main>
<footer class="site-footer" aria-label="Site footer"><div class="wrap">
<div class="about"><a class="logo" href="/">PHP<span>Hub</span></a><p>Practical PHP and WordPress security news, guides and tools.</p></div>
<div><h2 class="fh">Read</h2><ul><li><a href="/briefs">Briefs</a></li><li><a href="/articles">Articles</a></li><li><a href="/lessons">Lessons</a></li></ul></div>
<div><h2 class="fh">Help</h2><ul><li><a href="/services">Services</a></li><li><a href="/tools">Tools</a></li><li><a href="/contact">Contact</a></li><li><a href="/tags">Topics</a></li><li><a href="/rss.xml">RSS feed</a></li></ul></div>
<div><h2 class="fh">About</h2><ul><li><a href="/about">About</a></li><li><a href="/responsible-disclosure">Responsible disclosure</a></li><li><a href="/authorized-work">Authorized work only</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/terms">Terms</a></li></ul></div>
<div class="copy">© {new Date().getFullYear()} PHP Hub</div>
</div></footer>
<Analytics />
</body></html>
