---
const { title = 'PHP Hub' } = Astro.props;
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title === 'PHP Hub' ? title : `${title} · PHP Hub`}</title>
<style>
body{font:17px/1.65 system-ui,sans-serif;max-width:760px;margin:0 auto;padding:0 20px;color:#1d2433}
header{display:flex;gap:18px;align-items:center;padding:20px 0;border-bottom:1px solid #e5e7eb;flex-wrap:wrap}
header a{color:#374151;text-decoration:none}header .logo{font-weight:700;color:#4f46e5;margin-right:auto}
a{color:#4f46e5}code{background:#f3f4f6;padding:1px 5px;border-radius:4px}pre{background:#f3f4f6;padding:12px;overflow:auto}
.cta{border:1px solid #c7d2fe;background:#eef2ff;border-radius:10px;padding:18px;margin:40px 0}
footer{color:#6b7280;font-size:14px;padding:30px 0;border-top:1px solid #e5e7eb;margin-top:40px}
ul.items li{margin:8px 0}
</style></head><body>
<header><a class="logo" href="/">PHP Hub</a><a href="/briefs">Briefs</a><a href="/articles">Articles</a><a href="/lessons">Lessons</a><a href="/tools">Tools</a></header>
<main><slot/></main>
<div class="cta"><strong>Worried your PHP or WordPress site is affected?</strong>
<p>Start with the free <a href="https://php-security-checker.vercel.app">PHP Security Checker</a>. If you'd like a hand with a security audit or cleanup, get in touch and we'll take a look.</p></div>
<footer>PHP Hub · Practical PHP security news and guides.</footer>
</body></html>
