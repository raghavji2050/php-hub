---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import ChecklistCta from '../components/ChecklistCta.astro';
import { list } from '../lib.js';
import { TOOLS } from '../data/tools.js';
const briefs = list('briefs');
const latest = briefs[0];
const lessons = list('lessons').slice(0, 5);
const articles = list('articles');
const popularSlugs = ['php-security-checker', 'php-formatter', 'composer-analyzer', 'json-formatter', 'jwt-decoder', 'cron-generator'];
const popular = popularSlugs.map((slug) => TOOLS.find((tool) => tool.slug === slug)).filter(Boolean);
const description = 'Security briefs and practical lessons for PHP, Laravel and WordPress, written by Raghav and checked against official sources.';
const sevName = (latest?.severity || '').toLowerCase();
const sevClass = sevName === 'critical' || sevName === 'high' ? 'is-crit' : (latest?.severity || latest?.status) ? 'is-warn' : '';
const sevText = latest ? [latest.severity, latest.status].filter(Boolean).join(' · ') : '';
---
<Base description={description}>
<header class="masthead">
  <h1>Security briefs and lessons for PHP, Laravel, and WordPress.</h1>
  <p class="lead">Written by Raghav. When a vulnerability matters, a brief names the affected versions and the fix. Lessons cover the defenses you should already be using. Claims are checked against the official sources they name.</p>
  <p class="byline">By <a href="/about/">Raghav</a> · PHP Hub · Mohali</p>
</header>

{latest && <section aria-labelledby="brief-title">
  <div class="sec-head"><h2 id="brief-title">Latest brief</h2><a href="/briefs">All briefs</a></div>
  <article class="featured">
    <p class="meta-row">
      {sevText && <span class:list={['sev', sevClass]}>{sevText}</span>}
      {latest.dateLabel && <time datetime={latest.date}>{latest.dateLabel}</time>}
      <span>{latest.readingTime} min read</span>
    </p>
    <h3><a href={latest.url}>{latest.title}</a></h3>
    {latest.summary && <p class="dek">{latest.summary}</p>}
  </article>
</section>}

<section aria-labelledby="lessons-title">
  <div class="sec-head"><h2 id="lessons-title">Recent lessons</h2><a href="/lessons">All lessons</a></div>
  {lessons.map((item) => <Card item={item} section="lessons" level="h3" />)}
</section>

<section aria-labelledby="articles-title">
  <div class="sec-head"><h2 id="articles-title">Articles</h2><a href="/articles">All articles</a></div>
  <ul class="plain-list">
    {articles.map((item) => <li><a href={item.url}>{item.title}</a>{item.dateLabel && <time datetime={item.date}>{item.dateLabel}</time>}</li>)}
  </ul>
</section>

<section aria-labelledby="tools-title">
  <div class="sec-head"><h2 id="tools-title">Tools</h2><a href="/tools">All tools</a></div>
  <div class="tools-list">
    {popular.map((tool) => <div><a href={`/tools/${tool.slug}`}>{tool.title}</a><p>{tool.blurb}</p></div>)}
  </div>
</section>

<section class="services-note" aria-labelledby="services-title">
  <div class="sec-head"><h2 id="services-title">Services</h2><a href="/services">Service details</a></div>
  <p>Authorized security audits, malware cleanup, and PHP, Laravel or WordPress upgrades, only for sites you own or are authorized to manage. <strong>Price: Contact for quote.</strong></p>
</section>

<ChecklistCta />
</Base>
