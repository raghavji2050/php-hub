---
import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import { allCategories } from '../../lib.js';
export function getStaticPaths() { return allCategories().map(c => ({ params: { slug: c.slug }, props: { c } })); }
const { c } = Astro.props;
---
<Base title={`${c.name} posts`} description={`PHP Hub ${c.name} briefs, articles and lessons.`}><p><a class="back" href="/categories/">← All categories</a></p><h1>{c.name}</h1>
{c.posts.length ? <div class="grid">{c.posts.map(p => <Card item={p} level="h2" />)}</div> : <p>No {c.name} posts yet.</p>}</Base>
