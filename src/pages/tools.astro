---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolTile from '../components/ToolTile.astro';
import { TOOLS } from '../data/tools.js';
import { breadcrumbLd } from '../lib.js';
const crumbs = [{ href: '/', label: 'Home' }, { href: '/tools', label: 'Tools' }];
const groups = [
  ['php', 'PHP-specific'],
  ['general', 'General'],
];
---
<Base title="Developer Tools" description="Browser-side PHP and general developer tools: formatters, a JWT decoder, Composer analysis, cron, and a guide to the free PHP Security Checker. Nothing you paste is executed." jsonld={[breadcrumbLd(crumbs)]} cta={false}>
<Breadcrumbs items={crumbs} />
<div data-pagefind-body>
  <h1>Tools</h1>
  <p>These tools run in your browser. They do not execute PHP, do not send pasted input to PHP Hub, and they are not a vulnerability scanner.</p>
  {groups.map(([id, label]) => (
    <section aria-labelledby={`tools-${id}`}>
      <h2 id={`tools-${id}`}>{label}</h2>
      <div class="tiles">
        {TOOLS.filter((tool) => tool.group === id).map((tool) => <ToolTile tool={tool} />)}
      </div>
    </section>
  ))}
</div>
</Base>
