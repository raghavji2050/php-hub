---
import Base from '../../layouts/Base.astro'; import { list } from '../../lib.js';
export function getStaticPaths() { return list('briefs').map(i => ({ params: { slug: i.slug }, props: { item: i } })); }
const { item } = Astro.props; const { Content } = item;
---
<Base title={item.title}><p><a href="/briefs">← Briefs</a></p><article><Content /></article></Base>
