---
const { item } = Astro.props;
const LABEL = { briefs: 'Brief', articles: 'Article', lessons: 'Lesson' };
---
<article class="entry">
  {item.dateLabel && <time datetime={item.date}>{item.dateLabel}</time>}
  <div>
    <p class="row-meta">{LABEL[item.section] || item.section}</p>
    <h3 class="entry-title"><a href={item.url}>{item.title}</a></h3>
    {item.summary && <p class="dek">{item.summary}</p>}
  </div>
</article>
