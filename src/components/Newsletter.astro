---
// Newsletter signup is intentionally disabled until a provider is chosen. No endpoint, no keys.
---
<section class="newsletter" aria-labelledby="nl-title" data-pagefind-ignore>
  <h2 id="nl-title">Get new briefs by email <span class="badge status">Coming soon</span></h2>
  <p>Short alerts when a PHP or WordPress vulnerability needs action.</p>
  <p class="notice" role="status"><strong>Coming soon.</strong> Newsletter signup is not active yet. Nothing is sent or stored.</p>
  <form class="nl-form" onsubmit="return false" aria-disabled="true">
    <label class="sr-only" for="nl-email">Email address</label>
    <input id="nl-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" disabled/>
    <button type="button" disabled>Coming soon</button>
  </form>
</section>
