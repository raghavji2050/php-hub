---
const { name = 'brief', class: cls = 'icon' } = Astro.props;
---
{name === 'brief' && (
  <svg class={cls} viewBox="0 0 32 32" aria-hidden="true">
    <rect x="7" y="5" width="15" height="21" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.5"/>
    <path d="M11 11h7M11 15h7M11 19h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="23.5" cy="23.5" r="4.2" fill="var(--surface)" stroke="currentColor" stroke-width="1.5"/>
    <path d="M23.5 21.4v2.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="23.5" cy="25.4" r=".6" fill="currentColor"/>
  </svg>
)}
{name === 'lesson' && (
  <svg class={cls} viewBox="0 0 32 32" aria-hidden="true">
    <path d="M16 8.5c-2.2-1.6-5.4-2-8-1.2v16.2c2.7-.8 5.8-.4 8 1.2 2.2-1.6 5.3-2 8-1.2V7.3c-2.6-.8-5.8-.4-8 1.2z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    <path d="M16 8.7v16" stroke="currentColor" stroke-width="1.5"/>
    <path d="M11.5 13.2h3M11.5 16.2h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
  </svg>
)}
{name === 'tool' && (
  <svg class={cls} viewBox="0 0 32 32" aria-hidden="true">
    <rect x="5" y="7" width="22" height="18" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
    <path d="M5 12h22" stroke="currentColor" stroke-width="1.5"/>
    <circle cx="8.2" cy="9.5" r=".8" fill="currentColor"/>
    <circle cx="11.2" cy="9.5" r=".8" fill="currentColor"/>
    <path d="M11 17.5h4.5L13.2 22h4.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'service' && (
  <svg class={cls} viewBox="0 0 32 32" aria-hidden="true">
    <rect x="8" y="6" width="16" height="20" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.5"/>
    <path d="M12 11h8M12 15h8M12 19h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M10 6v-1.2c0-1 1.2-1.8 2.4-1.2L16 5l3.6-1.4c1.2-.6 2.4.2 2.4 1.2V6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
  </svg>
)}
