---
import Base from '../layouts/Base.astro';
import Card from './Card.astro';
import { list, related, slugify, SITE } from '../lib.js';
const { item, label } = Astro.props;
const { Content } = item;
const items = list(item.section);
const i = items.findIndex(x => x.slug === item.slug);
const newer = items[i - 1], older = items[i + 1];
const rel = related(item);
const toc = item.headings.filter(h => h.depth === 2);
const showToc = toc.length >= 4;
const jsonld = { '@context': 'https://schema.org', '@type': 'Article', headline: item.title.slice(0, 110), description: item.summary,
  datePublished: item.date || undefined, mainEntityOfPage: new URL(item.url, SITE.url).href, image: new URL('/og.png', SITE.url).href,
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url }, publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', SITE.url).href } },
  keywords: item.tags.join(', ') || undefined };
---
<Base title={item.title} description={item.summary} type="article" jsonld={jsonld}>
<article class="prose" data-pagefind-body>
  <a class="back" href={`/${item.section}`} data-pagefind-ignore>← {label}</a>
  <div class="post-meta" data-pagefind-ignore>
    {(item.severity || item.status) && <span class="badges">{item.severity && <span class={`badge sev-${item.severity.toLowerCase()}`}>{item.severity}</span>}{item.status && <span class="badge status">{item.status}</span>}</span>}
    <span class="meta">{item.dateLabel && <time datetime={item.date}>{item.dateLabel}</time>}{item.dateLabel && ' · '}{item.readingTime} min read</span>
  </div>
  {showToc && <details class="toc" open data-pagefind-ignore><summary>On this page</summary><ol>{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></details>}
  <Content />
  {item.tags.length > 0 && <ul class="tags" aria-label="Tags" data-pagefind-ignore>{item.tags.map(t => <li><a class="tag" href={`/tags/${slugify(t)}`}>#{t}</a></li>)}</ul>}
</article>
<nav class="prevnext" aria-label="More in this section" data-pagefind-ignore>
  {newer ? <a href={newer.url}><span>← Newer</span>{newer.title}</a> : <span/>}
  {older ? <a href={older.url} class="older"><span>Older →</span>{older.title}</a> : <span/>}
</nav>
{rel.length > 0 && <section class="related" data-pagefind-ignore><h2>Related</h2><div class="grid">{rel.map(r => <Card item={r} />)}</div></section>}
</Base>
<style>
.post-meta{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:16px 0 0}
.toc{border:1px solid var(--border);border-radius:10px;padding:12px 16px;margin:20px 0;font-size:16px;background:var(--surface)}
.toc summary{font-weight:700;cursor:pointer}.toc ol{margin:8px 0 0;padding-left:20px}
.prevnext{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:70ch;margin:40px auto 0}
.prevnext a{border:1px solid var(--border);border-radius:10px;padding:14px;text-decoration:none;color:var(--text);font-weight:600;font-size:15px;background:var(--surface)}
.prevnext a span{display:block;color:var(--muted);font-weight:400;font-size:13px}.prevnext .older{text-align:right}
.related{max-width:1040px;margin:40px auto 0}
@media (max-width:640px){.prevnext{grid-template-columns:1fr}.prevnext .older{text-align:left}}
</style>
