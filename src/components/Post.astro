---
import Base from '../layouts/Base.astro';
import ChecklistCta from './ChecklistCta.astro';
import HeroImage from './HeroImage.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Quiz from './Quiz.astro';
import { heroOg } from '../hero.js';
import { seriesAround } from '../data/series.js';
import { quizFor } from '../data/quizzes.js';
import { list, related, slugify, SITE, breadcrumbLd } from '../lib.js';
import { moveAiNote } from '../lib/move-ai-note.js';
const { item } = Astro.props;
const bodyHtml = moveAiNote(await item.compiledContent());
const items = list(item.section);
const i = items.findIndex(x => x.slug === item.slug);
const newer = items[i - 1], older = items[i + 1];
const rel = related(item);
const series = seriesAround(item.slug, items);
const quiz = quizFor(item.slug);
const toc = [];
for (const heading of item.headings) {
  if (heading.depth === 2 || !toc.length) toc.push({ ...heading, children: [] });
  else toc[toc.length - 1].children.push(heading);
}
const showToc = item.headings.length >= 2;
const og = (await heroOg(item.hero)) || '/og.png';
const sectionLabel = item.section === 'briefs' ? 'Briefs' : item.section === 'articles' ? 'Articles' : 'Lessons';
const singular = item.section === 'briefs' ? 'Brief' : item.section === 'articles' ? 'Article' : 'Lesson';
const crumbs = [{ href: '/', label: 'Home' }, { href: `/${item.section}`, label: sectionLabel }, { href: item.url, label: item.title }];
const sevName = (item.severity || '').toLowerCase();
const sevClass = sevName === 'critical' || sevName === 'high' ? 'is-crit' : (item.severity || item.status) ? 'is-warn' : '';
const sevText = [item.severity, item.status].filter(Boolean).join(' · ');
const jsonld = [{ '@context': 'https://schema.org', '@type': 'Article', headline: item.title.slice(0, 110), description: item.summary,
  datePublished: item.date || undefined, mainEntityOfPage: item.canonical || new URL(item.url, SITE.url).href, image: new URL(og, SITE.url).href,
  author: { '@type': 'Person', name: 'Raghav', url: `${SITE.url}/about` }, publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', SITE.url).href } },
  keywords: item.tags.join(', ') || undefined }, breadcrumbLd(crumbs)];
---
<Base title={item.title} description={item.summary} type="article" image={og} jsonld={jsonld} canonical={item.canonical || undefined} cta={true}>
<Breadcrumbs items={crumbs} />
<article class="prose" data-pagefind-body>
  <p class="kicker" data-pagefind-ignore>
    <a href={`/${item.section}`}>{singular}</a>
    {item.categories.map(c => <a class="cat-link" href={`/categories/${slugify(c)}/`}>{c}</a>)}
  </p>
  <h1>{item.title}</h1>
  <p class="byline post-byline" data-pagefind-ignore>
    <span>By <a href="/about/">Raghav</a></span>
    {sevText && <span class:list={['sev', sevClass]}>{sevText}</span>}
    {item.dateLabel && <time datetime={item.date}>{item.dateLabel}</time>}
    <span>{item.readingTime} min read</span>
    {item.level && <span class="level-label">{item.level}</span>}
    <span class="reading-bar" data-reading data-url={item.url} data-title={item.title} data-section={item.section}><button type="button" data-bookmark aria-pressed="false">Save</button> <a href="/saved">Saved items</a></span>
  </p>
  {item.hero && <figure class="post-hero"><HeroImage hero={item.hero} alt={item.heroAlt} eager fallback={false} /></figure>}
  {showToc && <details class="toc" open data-pagefind-ignore><summary>On this page</summary><ol>{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a>{h.children.length > 0 && <ol>{h.children.map(c => <li><a href={`#${c.slug}`}>{c.text}</a></li>)}</ol>}</li>)}</ol></details>}
  <div class="post-body" set:html={bodyHtml} />
  {item.tags.length > 0 && <ul class="tags" aria-label="Tags" data-pagefind-ignore>{item.tags.map(t => <li><a class="tag" href={`/tags/${slugify(t)}`}>#{t}</a></li>)}</ul>}
</article>
<ChecklistCta />
{quiz && <Quiz questions={quiz.questions} lessonUrl={item.url} />}
{series && <p class="series-note">Part {series.index + 1} of {series.total} in the {series.title}. {series.order}</p>}
{series && <nav class="prevnext" aria-label="Laravel security series" data-pagefind-ignore>
  {series.prev ? <a href={series.prev.url}><span>Previous</span>{series.prev.title}</a> : <span></span>}
  {series.next ? <a href={series.next.url}><span>Next</span>{series.next.title}</a> : <span></span>}
</nav>}
<nav class="prevnext" aria-label="More in this section" data-pagefind-ignore>
  {newer ? <a href={newer.url}><span>Newer</span>{newer.title}</a> : <span/>}
  {older ? <a href={older.url}><span>Older</span>{older.title}</a> : <span/>}
</nav>
{rel.length > 0 && <section class="related" aria-labelledby="related-title" data-pagefind-ignore>
  <h2 id="related-title">Related posts</h2>
  <ul class="thumb-list">{rel.map(r => <li>
    {r.hero ? <a class="mini-thumb" href={r.url} tabindex="-1" aria-hidden="true"><HeroImage hero={r.hero} alt="" width={160} height={90} fallback={false} sizes="96px" /></a> : <span class="ph">{r.section === 'briefs' ? (r.severity || 'Brief') : 'Note'}</span>}
    <a href={r.url}>{r.title}</a>
    {r.dateLabel && <time datetime={r.date}>{r.dateLabel}</time>}
  </li>)}</ul>
</section>}
<script is:inline src="/copy-code.js" defer></script>
<script is:inline src="/reading.js" defer></script>
</Base>
<style>
:global(.code-wrap){position:relative}
:global(.copy-btn){position:absolute;top:8px;right:8px;padding:4px 10px;font-size:12px;font-weight:600;border-radius:4px;border:1px solid var(--border);background:var(--surface);color:var(--text);font-family:var(--sans)}
:global(.copy-btn:hover){border-color:var(--brand);background:var(--surface);color:var(--text)}
.post-hero{margin:4px 0 8px}
.post-hero :global(img){width:100%;height:auto;border-radius:4px;display:block;aspect-ratio:1200/630;object-fit:cover}
.toc{border:1px solid var(--border);border-radius:4px;padding:12px 16px;margin:20px 0;font-size:16px;background:transparent}
.toc summary{font-weight:600;cursor:pointer;min-height:44px;display:flex;align-items:center}
.toc ol{margin:8px 0 0;padding-left:20px}
.prevnext{display:grid;grid-template-columns:1fr 1fr;gap:8px 28px;max-width:70ch;margin:28px 0 0;padding-top:8px}
.prevnext a{padding:12px 0;text-decoration:none;color:var(--text);font-weight:600;font-size:16px;min-width:0}
.prevnext a:hover{color:var(--brand)}
.prevnext a span{display:block;color:var(--muted);font-weight:500;font-size:13px;font-family:var(--sans)}
.related{max-width:70ch;margin:36px 0 0}
.series-note{max-width:70ch;margin:28px 0 0;color:var(--muted)}
@media (max-width:640px){.prevnext{grid-template-columns:1fr}}
</style>
