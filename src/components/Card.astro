---
import HeroImage from './HeroImage.astro';
const { item, section = item.section, level = 'h2', eager = false } = Astro.props;
const H = level;
const sevName = (item.severity || '').toLowerCase();
const sevClass = sevName === 'critical' || sevName === 'high' ? 'is-crit' : (item.severity || item.status) ? 'is-warn' : '';
const sevText = [item.severity, item.status].filter(Boolean).join(' · ');
const href = item.url || `/${section}/${item.slug}`;
const kind = section === 'briefs' || item.section === 'briefs' ? 'brief' : item.hero ? 'photo' : 'type';
const typeLabel = section === 'articles' ? 'Article' : section === 'lessons' ? 'Lesson' : 'Note';
---
<article class:list={['media-card', `media-${kind}`]} data-level={item.level || ''} data-sev={sevName}>
  {kind === 'photo' && (
    <a class="media-shot" href={href} tabindex="-1" aria-hidden="true">
      <HeroImage hero={item.hero} alt="" width={640} height={360} eager={eager} fallback={false} sizes="(max-width: 760px) 100vw, 480px" />
    </a>
  )}
  {kind === 'brief' && <p class:list={['media-flag', sevClass]}>{item.severity || 'Brief'}</p>}
  {kind === 'type' && <p class="media-flag">{typeLabel}</p>}
  <div class="media-copy">
    <p class="meta-row">
      {kind !== 'brief' && sevText && <span class:list={['sev', sevClass]}>{sevText}</span>}
      {kind === 'brief' && item.status && <span class:list={['sev', sevClass]}>{item.status}</span>}
      {item.level && <span class="level-label">{item.level}</span>}
      {item.dateLabel && <time datetime={item.date}>{item.dateLabel}</time>}
      {item.readingTime && <span>{item.readingTime} min read</span>}
    </p>
    <H class="entry-title"><a href={href}>{item.title}</a></H>
    {item.summary && <p class="dek">{item.summary}</p>}
  </div>
</article>
