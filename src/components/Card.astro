---
const { item, section = item.section, level = 'h3' } = Astro.props;
const sev = (item.severity || '').toLowerCase();
const H = level;
---
<a class="card" href={`/${section}/${item.slug}`}>
  {(item.severity || item.status) && <div class="badges">
    {item.severity && <span class={`badge sev-${sev}`}>{item.severity}</span>}
    {item.status && <span class="badge status">{item.status}</span>}
  </div>}
  <H class="card-title">{item.title}</H>
  {item.summary && <p>{item.summary}</p>}
  <span class="meta">{item.dateLabel && <time datetime={item.date}>{item.dateLabel}</time>}{item.dateLabel && ' · '}{item.readingTime} min read</span>
</a>
