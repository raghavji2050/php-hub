---
const { item, section = item.section, level = 'h2' } = Astro.props;
const H = level;
const sevName = (item.severity || '').toLowerCase();
const sevClass = sevName === 'critical' || sevName === 'high' ? 'is-crit' : (item.severity || item.status) ? 'is-warn' : '';
const sevText = [item.severity, item.status].filter(Boolean).join(' · ');
const href = item.url || `/${section}/${item.slug}`;
---
<article class="entry" data-level={item.level || ''} data-sev={sevName}>
  {item.dateLabel && <time datetime={item.date}>{item.dateLabel}</time>}
  <div>
    {(sevText || item.level) && <p class="meta-row">
      {sevText && <span class:list={['sev', sevClass]}>{sevText}</span>}
      {item.level && <span class="level-label">{item.level}</span>}
    </p>}
    <H class="entry-title"><a href={href}>{item.title}</a></H>
    {item.summary && <p class="dek">{item.summary}</p>}
    {item.readingTime && <p class="row-meta">{item.readingTime} min read</p>}
  </div>
</article>
