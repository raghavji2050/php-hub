---
const { items = [] } = Astro.props;
---
{items.length > 1 && (
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      {items.map((item, index) => (
        <li>
          {index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        </li>
      ))}
    </ol>
  </nav>
)}
<style>
.crumbs ol{display:flex;flex-wrap:wrap;gap:6px 0;list-style:none;margin:0 0 16px;padding:0;color:var(--muted);font-size:14px}
.crumbs li{display:inline-flex;align-items:center}
.crumbs li:not(:last-child)::after{content:"/";margin:0 8px;color:var(--muted)}
.crumbs a{color:var(--muted);text-decoration:none}
.crumbs a:hover{color:var(--text)}
.crumbs [aria-current="page"]{color:var(--text);font-weight:600;overflow-wrap:anywhere}
</style>
